# Copy to .env and fill in. Every setting is documented in backend/config.py.
# With nothing set at all, `make demo` still works: in-memory store, rule packs only.

# ---------------------------------------------------------------- GitHub
# Shared secret of the webhook (GitHub App settings -> Webhook secret). Required.
GITHUB_WEBHOOK_SECRET=
# Option A, a GitHub App (recommended): short-lived, repository-scoped tokens.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
# GITHUB_PRIVATE_KEY=   # or the PEM inline, with \n for newlines (handy on Railway)
# Option B, a fine-grained personal access token (pull requests: read/write, contents: read).
GITHUB_TOKEN=
# Login the reviewer posts as, e.g. my-review-app[bot]. Its own comments are ignored.
BOT_LOGIN=
# Comma-separated globs; empty = every repository that sends webhooks.
ALLOWED_REPOS=

# ------------------------------------------------------------ Data layer
# Tiger Cloud service URL (or any Postgres with pgvector). Empty = in-memory.
TIGER_DATABASE_URL=
# Queue + workflow checkpoints. Empty = jobs run inside the API process.
REDIS_URL=

# ------------------------------------------------------------- Models
# auto picks Anthropic if ANTHROPIC_API_KEY is set, else OpenAI, else rule packs only.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=          # any OpenAI-compatible gateway
# Per-agent routing; empty = provider defaults (see PROVIDER_MODELS in backend/config.py).
MODEL_SECURITY=
MODEL_QUALITY=
MODEL_TESTS=
MODEL_DOCS=
MODEL_FALLBACK=
# Embeddings use OpenAI text-embedding-3-large at 256 dimensions when OPENAI_API_KEY
# is set, otherwise a local hashing embedder. Changing dimensions means re-indexing.
EMBEDDING_PROVIDER=auto

# ------------------------------------------------- Selectivity and autonomy
# shadow | human_approves_all | exceptions_only. Start a new repository in shadow.
AUTONOMY_LEVEL=exceptions_only
HITL_CONFIDENCE_THRESHOLD=0.6
NOISE_FLOOR=0.3
MAX_INLINE_COMMENTS=12

# ------------------------------------------------------------ Economics
DAILY_BUDGET_USD=5
MAX_COST_PER_REVIEW_USD=0.75

# ------------------------------------------------- Dashboard and alerts
# token:role:name, comma separated. Roles: viewer < reviewer < admin.
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=
CORS_ORIGINS=http://localhost:3000
SLACK_WEBHOOK_URL=
ENVIRONMENT=development
