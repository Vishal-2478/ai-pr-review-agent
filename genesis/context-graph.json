  "invariants": [
    {
      "id": "I1",
      "statement": "Nothing in a webhook is parsed or trusted before its signature verifies.",
      "owners": [
        "webhook_receiver"
      ],
      "tests": [
        "test_signature_is_checked_before_the_body_is_parsed",
        "test_missing_secret_fails_closed"
      ]
    },
    {
      "id": "I2",
      "statement": "One review per commit, however many times the event arrives.",
      "owners": [
        "webhook_receiver",
        "job_queue",
        "database"
      ],
      "tests": [
        "test_same_commit_under_a_new_delivery_id_does_not_review_twice",
        "test_one_review_per_commit_under_concurrency"
      ]
    },
    {
      "id": "I3",
      "statement": "The ingress does no review work.",
      "owners": [
        "webhook_receiver"
      ],
      "tests": [
        "test_ingress_does_no_review_work"
      ]
    },
    {
      "id": "I4",
      "statement": "A slow or failing specialist never blocks the others or the join.",
      "owners": [
        "orchestrator",
        "agents"
      ],
      "tests": [
        "test_a_hung_specialist_cannot_deadlock_the_join",
        "test_model_failure_degrades_to_deterministic_rules"
      ]
    },
    {
      "id": "I5",
      "statement": "A finding that cannot be grounded in the diff never reaches the pull request on its own authority.",
      "owners": [
        "agents",
        "hitl"
      ],
      "tests": [
        "test_hallucinated_location_never_reaches_the_pull_request"
      ]
    },
    {
      "id": "I6",
      "statement": "Routing is deterministic code; a critical finding always goes to a human.",
      "owners": [
        "hitl"
      ],
      "tests": [
        "test_the_gate_is_deterministic_code",
        "test_gate_decision_table",
        "test_a_model_cannot_talk_a_deterministic_critical_down"
      ]
    },
    {
      "id": "I7",
      "statement": "Nothing is posted while a human decision is pending, and a review is posted at most once.",
      "owners": [
        "hitl",
        "integrations"
      ],
      "tests": [
        "test_nothing_is_posted_until_a_human_decides",
        "test_two_reviewers_cannot_decide_the_same_item"
      ]
    },
    {
      "id": "I8",
      "statement": "Secrets found in a diff are masked before a model, a log, the database or GitHub sees them.",
      "owners": [
        "security",
        "agents"
      ],
      "tests": [
        "test_secrets_in_the_diff_are_masked_before_the_model_sees_them",
        "test_golden_set_passes_the_regression_gate_in_rules_mode"
      ]
    },
    {
      "id": "I9",
      "statement": "Text in a pull request is data, never instruction.",
      "owners": [
        "security",
        "agents"
      ],
      "tests": [
        "test_prompt_injection_in_the_diff_is_data_not_instruction"
      ]
    },
    {
      "id": "I10",
      "statement": "The event log is append-only and every step writes to it.",
      "owners": [
        "observability",
        "database"
      ],
      "tests": [
        "test_event_spine_is_append_only",
        "test_every_step_is_on_the_event_spine"
      ]
    },
    {
      "id": "I11",
      "statement": "Only the orchestrator knows the workflow framework; specialists never import a vendor SDK; core and models depend on nothing.",
      "owners": [
        "core",
        "orchestrator",
        "agents"
      ],
      "tests": [
        "test_only_the_orchestrator_knows_langgraph",
        "test_specialists_never_talk_to_a_vendor_sdk",
        "test_core_and_models_depend_on_nothing_else"
      ]
    },
    {
      "id": "I12",
      "statement": "Money is checked before it is spent.",
      "owners": [
        "economics",
        "agents"
      ],
      "tests": [
        "test_budget_guard_blocks_at_the_cap_and_downgrades_before_it",
        "test_budget_exhaustion_falls_back_to_rules"
      ]
    }
  ]
}
