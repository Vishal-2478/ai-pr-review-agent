{
  "about": "Modules, the dependencies between them as they exist in the code, and the invariants that must hold. tests/test_architecture.py checks that every test named here exists and that the edges match the imports.",
  "nodes": [
    {
      "id": "core",
      "role": "WorkflowEngine interface and the exception taxonomy. Imports nothing else."
    },
    {
      "id": "models",
      "role": "Enums and plain data that cross module boundaries. Imports nothing else."
    },
    {
      "id": "config",
      "role": "Every setting, in one file."
    },
    {
      "id": "webhook_receiver",
      "role": "Verify, parse, deduplicate, enqueue, acknowledge."
    },
    {
      "id": "job_queue",
      "role": "Queue port (ARQ or inline), worker, job bodies."
    },
    {
      "id": "orchestrator",
      "role": "Workflow nodes; LangGraph and asyncio engines; Redis checkpointer."
    },
    {
      "id": "agents",
      "role": "Finding contract, four specialists, rule packs, grounding, aggregator."
    },
    {
      "id": "memory",
      "role": "Embedders and the hybrid context retriever."
    },
    {
      "id": "data",
      "role": "Chunking and repository indexing."
    },
    {
      "id": "hitl",
      "role": "Gate, approval queue, disputes, feedback calibration, capacity alerts."
    },
    {
      "id": "integrations",
      "role": "GitHub client, diff parser, review formatter, publisher."
    },
    {
      "id": "database",
      "role": "Store port with Postgres and in-memory implementations; migration runner."
    },
    {
      "id": "observability",
      "role": "Event spine, audit, alerting, logging."
    },
    {
      "id": "reliability",
      "role": "Retry, circuit breaker, timeout, idempotency."
    },
    {
      "id": "security",
      "role": "Secret masking, prompt-injection guard, roles."
    },
    {
      "id": "economics",
      "role": "Pricing, budget guard, routing advice."
    },
    {
      "id": "tools",
      "role": "Model client boundary, model router, tool registry."
    },
    {
      "id": "prompts",
      "role": "Versioned prompt files and their registry."
    },
    {
      "id": "evaluation",
      "role": "Golden set, judges, regression gate."
    },
    {
      "id": "api",
      "role": "Dashboard REST API."
    },
    {
      "id": "container",
      "role": "Composition root: the only place concrete implementations are chosen."
    }
  ],
